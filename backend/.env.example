DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB (leave unset for SQLite dev)
# DB_NAME=football
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis (leave unset for in-memory channel layer)
# REDIS_URL=redis://localhost:6379/0

# OBS WebSocket
OBS_WS_URL=ws://localhost:4455
OBS_WS_PASSWORD=change-me

# Football provider
FOOTBALL_PROVIDER=mock
FOOTBALL_API_KEY=

# Commentary provider: template | groq | anthropic | openai | ollama
COMMENTARY_PROVIDER=template
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Staleness threshold
STALE_THRESHOLD_SECONDS=30